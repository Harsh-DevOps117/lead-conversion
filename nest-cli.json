{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": ".",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true
  },
  "monorepo": true,
  "root": ".",
  "projects": {
    "auth": {
      "type": "application",
      "root": "apps/auth",
      "entryFile": "main",
      "sourceRoot": "apps/auth/src",
      "compilerOptions": {
        "tsConfigPath": "apps/auth/tsconfig.app.json"
      }
    },
    "call": {
      "type": "application",
      "root": "apps/call",
      "entryFile": "main",
      "sourceRoot": "apps/call/src",
      "compilerOptions": {
        "tsConfigPath": "apps/call/tsconfig.app.json"
      }
    },
    "gateway": {
      "type": "application",
      "root": "apps/gateway",
      "entryFile": "main",
      "sourceRoot": "apps/gateway/src",
      "compilerOptions": {
        "tsConfigPath": "apps/gateway/tsconfig.app.json"
      }
    },
    "lead": {
      "type": "application",
      "root": "apps/lead",
      "entryFile": "main",
      "sourceRoot": "apps/lead/src",
      "compilerOptions": {
        "tsConfigPath": "apps/lead/tsconfig.app.json"
      }
    },
    "lead-conversion": {
      "type": "application",
      "root": ".",
      "entryFile": "main",
      "sourceRoot": "apps/lead-conversion/src",
      "compilerOptions": {
        "tsConfigPath": "apps/lead-conversion/tsconfig.app.json"
      }
    },
    "payment": {
      "type": "application",
      "root": "apps/payment",
      "entryFile": "main",
      "sourceRoot": "apps/payment/src",
      "compilerOptions": {
        "tsConfigPath": "apps/payment/tsconfig.app.json"
      }
    }
  }
}